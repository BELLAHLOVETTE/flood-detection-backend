{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
    },
    "deploy": {
        "start": "python manage.py migrate --settings=config.settings.production && daphne -b 0.0.0.0 -p $PORT config.asgi:application",
        "restartPolicyType": "ON_FAILURE"
    }
}